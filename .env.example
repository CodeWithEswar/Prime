# PRIME Environment Variables Example
# Duplicate to .env.local for local development. Never commit real credentials.

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Local Development (default ports for `supabase start`)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# Supabase Server-Only Service Role Key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder"

# Resend Email Configuration (Optional in local development)
RESEND_API_KEY="re_placeholder_key"
EMAIL_FROM="PRIME <notifications@primeprep.app>"

# Cloudflare Account ID (for background Workers deployment)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_placeholder"

