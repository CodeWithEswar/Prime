# PRIME Environment Variables Example
# Duplicate to .env.local for local development. Never commit real credentials.

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Local Development (default ports for `supabase start`)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# Supabase Server-Only Service Role Key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder"

# Offline DSA catalog importer only. Use a privileged Postgres connection; never NEXT_PUBLIC_.
# Prefer the Supabase session pooler URL for a controlled CLI import.
PRIME_DSA_DATABASE_URL=""
# Required only for remote imports; must equal the connection URL hostname exactly.
PRIME_DSA_EXPECTED_HOST=""

# Resend Email Configuration (Optional in local development)
RESEND_API_KEY="re_placeholder_key"
EMAIL_FROM="PRIME <notifications@primeprep.app>"

# Cloudflare Account ID (for background Workers deployment)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_placeholder"

# Optional server-only Open-Meteo customer key for commercial deployments.
# Without a key, Open-Meteo's non-commercial free endpoints are used.
OPEN_METEO_API_KEY=""
# Optional HTTPS Photon-compatible reverse endpoint (city names only).
WEATHER_REVERSE_GEOCODER_URL="https://photon.komoot.io/reverse"

# PRIME AI: server-only. Never use NEXT_PUBLIC_ for these values.
PRIME_AI_ENABLED=false
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Cron & Background Worker Secrets (server-only)
# Required in production to authenticate internal cron dispatch requests
CRON_SECRET="your-secure-cron-secret-placeholder"
EMAIL_DELIVERY_INTERNAL_SECRET="your-secure-email-internal-secret-placeholder"

# Gmail SMTP / Custom Mailer (Optional alternative for revision reminders)
GMAIL_USER="your-notification-sender@gmail.com"
GMAIL_PASS="your-gmail-app-password"
