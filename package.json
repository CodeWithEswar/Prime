{
  "name": "prime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint app components lib tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:shell": "playwright test --config scripts/shell-qa.config.ts",
    "test:e2e:problem": "playwright test --config scripts/problem-qa.config.ts",
    "test:e2e:weather": "playwright test --config scripts/weather-qa.config.ts",
    "test:e2e:ai": "playwright test --config scripts/ai-qa.config.ts",
    "test:e2e:lab": "playwright test --config scripts/lab-qa.config.ts",
    "dsa:fetch": "tsx scripts/dsa/cli.ts fetch",
    "dsa:normalize": "tsx scripts/dsa/cli.ts normalize",
    "dsa:validate": "tsx scripts/dsa/cli.ts validate",
    "dsa:report": "tsx scripts/dsa/cli.ts report",
    "dsa:sync": "tsx scripts/dsa/cli.ts sync",
    "dsa:import": "tsx scripts/dsa/cli.ts import",
    "dsa:verify": "tsx scripts/dsa/cli.ts verify",
    "test:dsa": "vitest run tests/unit/dsa.test.ts tests/integration/dsa.test.ts",
    "lint:dsa": "eslint scripts/dsa tests/unit/dsa.test.ts tests/integration/dsa.test.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > lib/supabase/database.types.ts",
    "db:push": "supabase db push --linked",
    "prime-core:analyze": "tsx scripts/prime-core/cli.ts analyze",
    "prime-core:validate": "tsx scripts/prime-core/cli.ts validate",
    "prime-core:report": "tsx scripts/prime-core/cli.ts report",
    "prime-core:apply": "tsx scripts/prime-core/cli.ts apply",
    "worker:planner:dev": "wrangler dev --config workers/planner/wrangler.jsonc",
    "worker:reminders:dev": "wrangler dev --config workers/reminders/wrangler.jsonc",
    "aptitude:generate": "node scripts/generate-aptitude-curriculum.mjs",
    "aptitude:seed": "node --env-file=.env.local scripts/aptitude/seed-aptitude-db.mjs",
    "aptitude:verify-videos": "node scripts/aptitude/verify-videos.mjs",
    "aptitude:check-language": "node scripts/aptitude/check-audio-language.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "@types/katex": "^0.16.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "groq-sdk": "^1.6.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "mermaid": "^12.3.0",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "nuqs": "^2.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.35.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "csv-parse": "7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "postgres": "4.0.0",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@12.4.1"
}
